    var JSONObject = data;
    var canvas = document.getElementById('scheme-canvas');
    var selectForm = document.forms.bookingSettings;
    let schemeData = new SchemeData(JSONObject);

    var schemeViewe = new SchemeViewer(canvas, schemeData);
    var schemeBookingSetting = new SchemeBookingSettings(selectForm, schemeData.bookingSettings);

    var caption = document.getElementById('placeName');
    caption.textContent = schemeData.place.name;
    //});


    var but = document.getElementById('save');
    but.addEventListener("click", function () { saveSchemeData(this.getAttribute("data-guid")); });

    function saveSchemeData(place_id) {
            console.log('schemeData.bookingList.list', schemeData.bookingList.list);
            var current_list = [];
            var list = schemeData.bookingList.list;
            for (var i = 0; i < list.length; i++) {
                current_list.push({
                    "title":"title",
                    "place_id":place_id,
                    "object_id":list[i]._guid,
                    "price":list[i]._price*1,
                    "time_start":list[i]._timeStart.toISOString()replace(/T/, ' ').replace(/\..+/, ''),
                    "tyme_end":list[i]._timeEnd.toISOString()replace(/T/, ' ').replace(/\..+/, ''),
                });
            };
            console.log("current_list", current_list);
    }
</script>
