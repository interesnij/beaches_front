<% include!("../partials/h.stpl"); %>
<style>
    .canvas-holder {
        width: 100%;
        height: 700px;
        position: relative;
    }
</style>
<script src="/assets/js/scheme-designer-editor.js"></script>

 <div class="main-content app-content">
            <div class="container-fluid">

                <!-- Page Header -->
                <div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
                    <div class="my-auto">
                        <h5 class="page-title fs-21 mb-1"><%= object.title %></h5>
                        <nav> 
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a href="/">Главная</a></li>
                                <li class="breadcrumb-item active" aria-current="page"><%= object.title %></li>
                            </ol>
                        </nav>
                    </div>
                </div>
                <!-- Page Header Close -->

                <!-- Start::row-1 -->
                <div class="row">
                    <div class="col-xl-12">
                        <div class="card">
                            <div class="card-body h-100">
                                <div class="row ">
                                    <div class=" col-xl-5 col-lg-12 col-md-12">
                                        <div class="product-carousel  border br-5">
                                            <div id="Slider" class="carousel slide" data-bs-ride="false">
                                                <div class="carousel-inner py-3">
                                                    <div class="carousel-item active">
                                                        <img src="/assets/images/ecommerce/13.png" alt="img" class="img-fluid mx-auto d-block">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="details col-xl-7 col-lg-12 col-md-12 mt-4 mt-xl-0">
                                        <h5 class="product-title mb-1"><%= object.title %></h5>
                                        <p class="text-muted fs-13 mb-1">
                                            <% if object.cord.is_some() { %>
                                                <%= object.cord.as_deref().unwrap() %>
                                            <% } else { %>
                                                Координаты не указаны
                                            <% } %>
                                        </p>
                                        <div class="rating mb-1">
                                            <div class="stars">
                                                <span class="bx bxs-star fs-17 align-center checked"></span>
                                                <span class="bx bxs-star fs-17 align-center checked"></span>
                                                <span class="bx bxs-star fs-17 align-center checked"></span>
                                                <span class="bx bxs-star fs-17 align-center text-muted"></span>
                                                <span class="bx bxs-star fs-17 align-center text-muted"></span>
                                            </div>
                                            <span class="review-no">41 reviews</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!--End::row-1 -->

                <!-- Start::row-2 -->
                <div class="related-products-ltr-l" style="margin-bottom:50px">
                <div class="container" style="max-width: 1600px; max-height: 800px; min-width: 800px; min-height: 400px;">
                        <div style="text-align: center; max-width: 2400px;">
            <div style="display: flex;  max-width: 2400px">
                <div class="container" style="max-width: 200px; height: 800px;">
                    <canvas id="scheme-select-module" style="border: 1px solid #ccc;">
                        Ваш браузер не поддерживает элемент canvas.
                    </canvas>
                </div>
                <div class="container" style="max-width: 2200px; max-height: 800px;">
                    <canvas id="scheme-canvas" tabindex='1' style="border: 1px solid #ccc;">
                        Ваш браузер не поддерживает элемент canvas.
                    </canvas>
                </div>

                <form name="selectedModuleSettings">
                    <h3>Модуль</h3>
                    <div style="display:none">
                        <label for="settingsGuid">id</label>
                        <input type="text" id="settingsGuid" required size="10" />
                    </div>
                    <div>
                        <label for="settingsName">Название</label>
                        <input type="text" id="settingsName" required size="10" />
                    </div>
                    <div style="display:none">
                        <label for="settingsLabel">Подпись</label>
                        <input type="text" id="settingsLabel" required size="10" />
                    </div>
                    <div>
                        <label for="settingsPrice">Стоимость</label>
                        <input type="text" id="settingsPrice" required size="10" />
                    </div>
                    <div>
                        <label for="settingsLeft">Отступ слева</label>
                        <input type="text" id="settingsLeft" required size="10" />
                    </div>
                    <div>
                        <label for="settingsTop">Отступ сверху</label>
                        <input type="text" id="settingsTop" required size="10" />
                    </div>
                    <div>
                        <label for="settingsWidth">Ширина</label>
                        <input type="text" id="settingsWidth" required size="10" />
                    </div>
                    <div>
                        <label for="settingsHeight">Высота</label>
                        <input type="text" id="settingsHeight" required size="10" />
                    </div>
                    <div>
                        <label for="settingsAngle">Глубина</label>
                        <input type="text" id="settingsAngle" required size="10" />
                    </div>

                </form>
            </div>

            <div class="well">
                <div class="row">
                    <div class="well">
                        <div class="row">
                            <div class="col-sm-12" style="margin-bottom: 20px;margin-top: 15px;text-align: right">
                                <button data-guid="<%= object.id %>" id="save" type="button" class="btn btn-info">
                                    Сохранить
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
                    </div>
                </div>
            </div>
        </div>

<script type="module">
    import { SchemeData } from '/assets/js/scheme-data.js';
    import { Observer } from '/assets/js/data/observer.js';
    import { SchemeSelectModule } from '/assets/js/scheme-select-module.js';
    import { SchemeEditor } from '/assets/js/scheme-editor.js';
    import { SchemeModuleSettings } from '/assets/js/scheme-module-settings.js';
    import { SchemePlaceSettings } from '/assets/js/scheme-place-settings.js';

    var modules_22 = [];
    var types_22 = [];
    types_22.push ({
        "guid": "<%= object.id %>",
        "type": "Place",
        "name": "",
        "description": "",
        "price": 0,
        "imageUrl": "<%= object.get_background() %>",
    });
    <% for i in module_types.iter() { %>
        types_22.push ({
            "guid": "<%= i.id %>",
            "type": "<%= i.types %>",
            "name": "<%= i.title %>",
            "description": "<%= i.description %>",
            "price": <%= i.price %>,
            "imageUrl": "<%= i.get_image() %>",
        });
    <% } %>
    <% for (i, object) in modules.iter().enumerate() { %>
        modules_22.push ({
                    "guid": "<%= object.id %>",
                    "name": "<%= object.title %>",
                    "objectName": "Module",
                    "typeModulesGuid": "<%= object.type_id %>",
                    "width": <%= object._width %>,
                    "height": <%= object._height %>,
                    "left": <%= object._left %>,
                    "top": <%= object._top %>,
                    "label":  "<%= i %>",
                    "price": "<%= object.price %>",
                    "angle": <%= object._angle %>,
                    "fontColor": "<%= object.font_color %>",
                    "fontSize": "<%= object.font_size %>",
                    "backColor": "<%= object.back_color %>"
                });
    <% } %>

    //window.addEventListener('load', (event) => {
    var data = {
    "version": "0.1",
    "place": {
        "id": "",
        "name": "Выберите места",
        "description": "Выберите места",
        "guid": "C85B7E02-8B1C-4C2F-B4FE-7CD52314DCE3"
    },
    "workspace": {
        "placeGuid": "<%= object.id %>",
        "width": 1600,
        "height": 900,
        "backgroundGuid": "<%= object.get_background() %>"
    },
    "settings": {
        "placeGuid": "C85B7E02-8B1C-4C2F-B4FE-7CD52314DCE3",
        "options": {
            "cacheSchemeRatio": 0
        },
        "scroll": {
            "draggable": true,
            "draggableLeft": true,
            "draggableTop": true,
            "maxHiddenPart": 0.5
        },
        "zoom": {
            "padding": 0.1,
            "maxScale": 1.5,
            "zoomCoefficient": 1.04
        },
        "storage": {
            "treeDepth": 3
        }
    },
    "typeModules": types_22,
    "modules": modules_22,
        "bookings": []
}
    console.log("incomming modules", data["modules"]);
    var canvas = document.getElementById('scheme-canvas');
    var selectForm = document.forms.selectedModuleSettings;
    let schemeData = new SchemeData(data);
    //test data
    let observerPlace = new Observer('Place observer');
    observerPlace.subscribe(schemeData.place);
    let observerTypeModules = new Observer('TypeModules observer');
    observerTypeModules.subscribe(schemeData.typeModulesList);
    let observerModules = new Observer('Modules observer');
    observerModules.subscribe(schemeData.modulesList);
    //------------
    var canvasSelect = document.getElementById('scheme-select-module');
    var schemeSelectModule = new SchemeSelectModule(canvasSelect, schemeData);
    var schemeEditor = new SchemeEditor(canvas, schemeData);
    var schemeModuleSettings = new SchemeModuleSettings(selectForm, schemeData);
    //var schemePlaceSettings = new SchemePlaceSettings(document.forms.placeSettings, schemeData);


    var but = document.getElementById('save');
    but.addEventListener("click", function () { saveSchemeData(this.getAttribute("data-guid")); });

    function saveSchemeData(id) {
        let str = JSON.stringify(schemeData, null, 2);
        console.log("schemeData", schemeData);
        console.log("first list", schemeData["modulesList"]["list"]);
        var first_list = schemeData["modulesList"]["list"];
        var modules_list = schemeData["typeModulesList"]["list"];
        console.log("modules_list", schemeData["typeModulesList"]["list"]);
        var place_id = id;
        var modules2 = [];
        for (var i = 0; i < first_list.length; i++){
            var filtered = modules_list.filter(function (item) {
                return item._guid === first_list[i]["_typeModulesGuid"];
            });
            console.log("filtered", filtered);
                var image = modules_list
                var _module = {
                    id:         first_list[i]["_guid"],
                    title:      first_list[i]["_name"],
                    label:      first_list[i]["_label"],
                    type_id:    first_list[i]["_typeModulesGuid"],
                    price:      first_list[i]["_price"]*1,
                    z_index:    1,
                    width:      first_list[i]["_width"],
                    height:     first_list[i]["_height"],
                    left:       first_list[i]["_left"] *1.0,
                    top:        first_list[i]["_top"] *1.0,
                    angle:      0.0,
                    font_color: first_list[i]["_fontColor"],
                    font_size:  first_list[i]["_fontSize"],
                    back_color: first_list[i]["_backColor"],
                    image:      filtered[0]["_imageUrl"],
                }; 
                modules2.push(_module);
        }
        var __data = {
            place_id: place_id,
            modules:  modules2,
        };

        console.log("current list", _module);
        console.log("__data", __data);

        var link = window.XMLHttpRequest ? new XMLHttpRequest() : new ActiveXObject( 'Microsoft.XMLHTTP' );
    
        link.open( 'POST', "/place/create_modules/", true );
        link.setRequestHeader('Content-Type', 'application/json');
    
        link.onreadystatechange = function () {
        if ( link.readyState == 4 && link.status == 200 ) {
            console.log("ok!!");
            alert("Изменения сохранены!")
        }} 
        link.send(JSON.stringify(__data));
    }

</script>
<% include!("../partials/f.stpl"); %>