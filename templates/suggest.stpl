<% include!("partials/h.stpl"); %>

<div class="main-content app-content">
    <div class="container-fluid">
        <div class="card custom-card" style="min-height: inherit;">
            <div class="card-header justify-content-between">
                <div class="card-title">
                    Создпние заявки на партнерство
                </div>
            </div> 
            <div class="card-body"> 
                        <form>
                            <div class="mb-3">
                                <label class="form-label">Название компании</label>
                                <input type="text" id="id_title" name="title" class="form-control" placeholder="Название компании" aria-label="Title">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">ИНН</label>
                                <input type="text" id="id_inn" name="inn" class="form-control" placeholder="ИНН" aria-label="Сord">
                            </div>
                            <p class="api_response error"></p>
                            <div class="col-md-12">
                                <button type="button" id="create_suggest_item" class="btn btn-primary">Отправить</button>
                            </div>
                        </form>
                    </div>
        </div>
    </div>
</div>

<% include!("partials/f.stpl"); %>