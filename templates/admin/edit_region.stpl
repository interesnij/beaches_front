<% include!("../partials/h.stpl"); %>

<div class="main-content app-content">
    <div class="container-fluid">
        <div class="card custom-card">
            <div class="card-header justify-content-between">
                <div class="card-title">
                    Изменение региона <%= object.name %>
                </div>
            </div> 
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <form>
                            <div class="mb-3">
                                <label class="form-label">Название региона</label>
                                <input type="text" value="<%= object.name %>" id="id_name" name="name" class="form-control" placeholder="Название региона" aria-label="Title">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Координаты</label>
                                <% if object.cord.is_some() { %>
                                    <input type="text" id="id_cord" value="<%= object.cord.as_deref().unwrap() %>" name="cord" class="form-control" placeholder="Широта и долгота через запятую" aria-label="Сord">
                                <% } else { %>
                                    <input type="text" id="id_cord" name="cord" class="form-control" placeholder="Широта и долгота через запятую" aria-label="Сord">
                                <% } %>
                            </div>
                            <p class="api_response error"></p>
                            <div class="col-md-12">
                                <button type="button" id="edit_region" class="btn btn-primary">Изменить</button>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-4">
                        <h4>Регионы</h4>

                        <% for object in regions.iter() { %>
                            <p><%= object.name %> (<a href="/region/<%= object.id %>/edit/">изменить</a>, <span class="delete_region" style="cursor: pointer">удалить</span>)</p>
                        <% } %>
                    </div>
            </div>
        </div>
    </div>
</div>

<% include!("../partials/f.stpl"); %>