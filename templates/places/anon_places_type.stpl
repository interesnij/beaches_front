<% include!("../partials/anon_h.stpl"); %>

<div class="main-content app-content">
            <div class="container-fluid">
                <div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
                    <div class="my-auto">
                        <h5 class="page-title fs-21 mb-1">Все объекты</h5>
                        <nav>
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a href="/">Главная</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Все объекты</li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-2">
                    <div class="g-4">
                        <% for object in object_list.iter() { %>
                        <div class="">
                            <a href="/place/<%= object.id %>/">
                            <div class="card custom-card">
                                <% if object.image.is_some() { %>
                                    <img src="<%= object.image.as_deref().unwrap() %>" class="card-img-top _nice" alt="place_img">
                                <% } else { %>
                                    <img src="/assets/images/media/media-44.jpg" class="card-img-top" alt="place_img">
                                <% } %>
                                <div class="card-body">
                                    <h6 class="card-title fw-semibold">
                                        <%= object.title %>
                                    </h6>
                                </div>
                            </div>
                            </a>
                        </div>
                        <% } %>
                    </div>
                </div>
                <div class="col-md-10">
                    <div id="map"></div>
                </div>
            </div>
</div>


<% if object_list.len() > 0 { %>
<% let first = &object_list[0]; %>
<script src="https://api-maps.yandex.ru/2.1/?lang=ru_RU&amp;apikey=6b6dea55-7e3b-42f2-899f-adb069b5fdd4&suggest_apikey=6d98461b-030b-42e8-9a8b-0ad3c4bea025" type="text/javascript"></script>
<script>
ymaps.ready(init);

function init() {
    var myMap;
    ymaps.geocode('43.580808, 39.718660').then(function (res) {
        myMap = new ymaps.Map('map', {
            center: res.geoObjects.get(0).geometry.getCoordinates(),
            zoom : 4
        }); 

        var addToMap = function(inputAdress) {
            ymaps.geocode(inputAdress, {
                boundedBy: myMap.getBounds(),
                results: 1
            }).then(function(res) {
                myMap.geoObjects.add(res.geoObjects.get(0));
            });
        };

        <% for i in object_list.iter() { %>
            <% if i.cord.is_some() { %>
                var myPlacemark = new ymaps.Placemark([<%= i.cord.as_deref().unwrap() %>], {
                    balloonContentHeader: "<%= i.title %>",
                    balloonContentBody: "<a href='/place/<%= i.id %>/' target='_blank'><%= i.title %></a>",
                    iconLayout: 'default#image',
                    iconImageHref: "<%= i.get_image() %>",
                    iconImageSize: [30, 44],
                    iconImageOffset: [-15, -44]
                }, 
                    {
                        preset: 'islands#yellowDotIcon'
                    }
                );
                myMap.geoObjects.add(myPlacemark);
                
            <% } %>
        <% } %>
    });
}
</script>
<% } %>

<% include!("../partials/anon_f.stpl"); %>