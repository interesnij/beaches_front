<% include!("../partials/h.stpl"); %>
<style>
    .canvas-holder {
        width: 100%;
        height: 700px;
        position: relative;
    }
</style>
<script src="/assets/js/scheme-designer-viewer.js"></script>
<script src="/assets/js/scheme-select-module.js"></script>
<script src="/assets/js/scheme-viewer.js"></script>

 <div class="main-content app-content">
            <div class="container-fluid">

                <!-- Page Header -->
                <div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
                    <div class="my-auto">
                        <h5 class="page-title fs-21 mb-1"><%= object.title %></h5>
                        <nav>
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item"><a href="/">Главная</a></li>
                                <li class="breadcrumb-item"><a href="/places/">Все объекты</a></li>
                                <li class="breadcrumb-item active" aria-current="page"><%= object.title %></li>
                            </ol>
                        </nav>
                    </div>
                </div>
                <!-- Page Header Close -->

                <!-- Start::row-1 -->
                <div class="row">
                    <div class="col-xl-12">
                        <div class="card">
                            <div class="card-body h-100">
                                <div class="row ">
                                    <div class=" col-xl-5 col-lg-12 col-md-12">
                                        <div class="product-carousel  border br-5">
                                            <div id="Slider" class="carousel slide" data-bs-ride="false">
                                                <div class="carousel-inner py-3">
                                                    <div class="carousel-item active">
                                                    <% if object.image.is_some() { %>
                                                        <img src="<%= object.image.as_deref().unwrap() %>" class="img-fluid mx-auto d-block" alt="place_img">
                                                    <% } else { %>
                                                        <img src="/assets/images/media/media-44.jpg" class="img-fluid mx-auto d-block" alt="place_img">
                                                    <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="details col-xl-7 col-lg-12 col-md-12 mt-4 mt-xl-0">
                                        <h5 class="product-title mb-1"><%= object.title %></h5>
                                        <p class="text-muted fs-13 mb-1">
                                            <% if object.cord.is_some() { %>
                                                <%= object.cord.as_deref().unwrap() %>
                                            <% } %>
                                        </p>
                                        <div class="rating mb-1">
                                            <div class="stars">
                                                <span class="bx bxs-star fs-17 align-center checked"></span>
                                                <span class="bx bxs-star fs-17 align-center checked"></span>
                                                <span class="bx bxs-star fs-17 align-center checked"></span>
                                                <span class="bx bxs-star fs-17 align-center text-muted"></span>
                                                <span class="bx bxs-star fs-17 align-center text-muted"></span>
                                            </div>
                                            <span class="review-no">41 reviews</span>
                                        </div>
                                        <% if request_user.is_superuser() || request_user.id == object.user_id { %>
                                            <a href="/place/<%= object.id %>/create_map/">Модули</a>
                                            | 
                                            <a href="/place/<%= object.id %>/edit/">Инфо</a>
                                            | 
                                            <a href="/place/<%= object.id %>/create_module_type/">Типы модулей</a>
                                            | 
                                            <a href="/place/<%= object.id %>/create_event/">События</a>
                                            |
                                            <form data-id="<%= object.id %>">
                                                <input style="display:none" name="image" id="id_place_image" class="input-md form-control" type="file" />
                                            </form> 
                                            <a class="change_place_avatar" style="cursor:pointer">Аватар</a>
                                            |
                                            <form data-id="<%= object.id %>">
                                                <input style="display:none" name="image" id="id_place_background" class="input-md form-control" type="file" />
                                            </form> 
                                            <a class="change_place_background" style="cursor:pointer">Фон</a>
                                        <% } %>
                                    </div> 
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!--End::row-1 -->

                <!-- Start::row-2 -->
                <div class="related-products-ltr-l" style="margin-bottom:50px">
                <div class="container" style="max-width: 1600px; max-height: 800px; min-width: 800px; min-height: 400px;">
                        <div style="text-align: center;margin-bottom:10px">
                            <h2 id="placeName">Схема пляжа</h2>
                            <form name="bookingSettings" style="display: flex; text-align: justify; margin-bottom:50px;">
                                <div style="font-size: 20px;">
                                    <label for="booking-date">Дата:</label>
                                    <input type="date" id="bookingDate" name="booking-date" />
                                </div>
                                <div style="margin-left: 15px;font-size: 20px;">
                                    <label for="booking-time-start">Начало:</label>
                                    <input type="time" id="bookingTimeStart" name="time-start" required />
                                </div>
                                <div style="margin-left: 15px;font-size: 20px;">
                                    <label for="booking-time-end">Окончание:</label>
                                    <input type="time" id="bookingTimeEnd" name="time-end" min="09:30" max="18:00" required />
                                </div>
                                <div style="margin-left: 15px;font-size: 20px;">
                                    <button data-guid="<%= object.id %>" id="save" type="button" class="btn btn-info">
                                        Сделать заказ
                                    </button>
                                </div>
                            </form>
                            <div style="height: 600px;">
                                <canvas id="scheme-canvas" style="border: 1px solid #ccc;">
                                    Ваш браузер не поддерживает элемент canvas.
                                </canvas>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

<script type="module">
    import { SchemeData } from '/assets/js/scheme-data.js';
    import { Observer } from '/assets/js/data/observer.js';
    import { SchemeSelectModule } from '/assets/js/scheme-select-module.js';
    import { SchemeViewer } from '/assets/js/scheme-viewer.js';
    import { SchemeBookingSettings } from '/assets/js/scheme-booking-settings.js';

    var modules_22 = [];
    var orders_22 = [];
    var types_22 = []; 

    types_22.push ({
        "guid": "<%= object.id %>",
        "type": "Place",
        "name": "",
        "description": "",
        "price": 0,
        "imageUrl": "<%= object.get_background() %>",
    });

    <% for i in module_types.iter() { %>
        types_22.push ({
            "guid": "<%= i.id %>",
            "type": "<%= i.types %>",
            "name": "<%= i.title %>",
            "description": "<%= i.description %>",
            "price": <%= i.price %>,
            "imageUrl": "<%= object.get_image() %>",
        });
    <% } %>
    <% for (i, object) in modules.iter().enumerate() { %>
        modules_22.push ({
                    "guid": "<%= object.id %>",
                    "name": "<%= object.title %>",
                    "objectName": "Module",
                    "typeModulesGuid": "<%= object.type_id %>",
                    "width": <%= object._width %>,
                    "height": <%= object._height %>,
                    "left": <%= object._left %>,
                    "top": <%= object._top %>,
                    "label":  "<%= i %>",
                    "price": "<%= object.price %>",
                    "angle": <%= object._angle %>,
                    "fontColor": "<%= object.font_color %>",
                    "fontSize": "<%= object.font_size %>",
                    "backColor": "<%= object.back_color %>"
                });
    <% } %>

    <% for object in orders.iter() { %>
        orders_22.push ({
            "date": "<%= object.created %>",
            "_guid": "<%= object.object_id %>",
            "_isMyBooking": <%= object.user.id == request_user.id %>,
            "_moduleGuid": "",
            "price": "<%= object.price %>",
            "_timeEnd": "<%= object.time_end %>",
            "_timeStart": "<%= object.time_start %>",
        });
    <% } %>
    var data = {
        "version": "0.1",
        "place": {
            "id": "",
            "name": "Выберите места",
            "description": "Выберите места",
            "guid": "C85B7E02-8B1C-4C2F-B4FE-7CD52314DCE3"
        },
        "workspace": {
            "placeGuid": "C85B7E02-8B1C-4C2F-B4FE-7CD52314DCE3",
            "width": 1600,
            "height": 900,
            "backgroundGuid": "<%= object.id %>"
        },
        "settings": {
            "placeGuid": "C85B7E02-8B1C-4C2F-B4FE-7CD52314DCE3",
            "options": {
                "cacheSchemeRatio": 0
            },
            "scroll": {
                "draggable": true,
                "draggableLeft": true,
                "draggableTop": true,
                "maxHiddenPart": 0.5
            },
            "zoom": {
                "padding": 0.1,
                "maxScale": 1.5,
                "zoomCoefficient": 1.04
            },
            "storage": {
                "treeDepth": 3
            }
        },
        "typeModules": types_22,
        "modules": modules_22,
        "bookings": []
    }
    //var JSONObject = JSON.parse(data);

    console.log("incomming modules", data["modules"]);
    
    var JSONObject = data;
    var canvas = document.getElementById('scheme-canvas');
    var selectForm = document.forms.bookingSettings;
    let schemeData = new SchemeData(JSONObject);

    var schemeViewe = new SchemeViewer(canvas, schemeData);
    var schemeBookingSetting = new SchemeBookingSettings(selectForm, schemeData.bookingSettings);

    var caption = document.getElementById('placeName');
    caption.textContent = schemeData.place.name;
    //});


    var but = document.getElementById('save');
    but.addEventListener("click", function () { saveSchemeData(this.getAttribute("data-guid")); });

    function saveSchemeData(place_id) {
            console.log('schemeData.bookingList.list', schemeData.bookingList.list);
            var current_list = [];
            var list = schemeData.bookingList.list;
            if (orders_22.length > 10) {
                console.log("Order s too match!");
                return
            }
            for (var i = 0; i < list.length; i++) {
                current_list.push({
                    "title":"title",
                    "place_id":place_id,
                    "object_id":list[i]._guid,
                    "price":list[i]._price*1,
                    "time_start":list[i]._timeStart.toISOString().replace(/T/, ' ').replace(/\..+/, ''),
                    "time_end":list[i]._timeEnd.toISOString().replace(/T/, ' ').replace(/\..+/, '')
                });
            }
                console.log("current_list", current_list);

                var link = window.XMLHttpRequest ? new XMLHttpRequest() : new ActiveXObject( 'Microsoft.XMLHTTP' );
                link.open( 'POST', "/create_order/", true );
                link.setRequestHeader('Content-Type', 'application/json');
            
                link.onreadystatechange = function () {
                if ( link.readyState == 4 && link.status == 200 ) {
                    console.log("ok!!");
                    alert("Заказ сделан.")
                }} 
                link.send(JSON.stringify(current_list));
                
    }
</script>
<% include!("../partials/f.stpl"); %>