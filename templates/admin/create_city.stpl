<% include!("../partials/h.stpl"); %>

<div class="main-content app-content">
    <div class="container-fluid">
        <div class="card custom-card">
            <div class="card-header justify-content-between">
                <div class="card-title">
                    Добавление города
                </div>
            </div> 
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <form>
                            <div class="mb-3">
                                <label class="form-label">Название города</label>
                                <input type="text" id="id_name" name="name" class="form-control" placeholder="Название города" aria-label="Title">
                            </div>
                            <select id="id_region" name="region_id" class="form-select" aria-label="Select">
                                <option selected="">Выберите регион</option>
                                <% for object in regions.iter() { %>
                                    <option value="<%= object.id %>"><%= object.name %></option>
                                <% } %>
                            </select>
                            <div class="mb-3">
                                <label class="form-label">Координаты</label>
                                <input type="text" id="id_cord" name="cord" class="form-control" placeholder="Широта и долгота через запятую" aria-label="Сord">
                            </div>
                            <p class="api_response error"></p>
                            <div class="col-md-12">
                                <button type="button" id="create_city" class="btn btn-primary">Добавить</button>
                            </div>
                        </form>
                    </div>
                    <div class="col-md-4">
                    <h4>Города</h4>

                    <% for object in cities.iter() { %>
                        <p></p>
                    <% } %>
                    </div>
            </div>
        </div>
    </div>
</div>

<% include!("../partials/f.stpl"); %>