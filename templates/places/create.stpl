<% include!("../partials/h.stpl"); %>

<div class="main-content app-content">
    <div class="container-fluid">
        <div class="card custom-card">
            <div class="card-header justify-content-between">
                <div class="card-title">
                    Создание объекта
                </div>
            </div> 
            <div class="card-body"> 
                <form enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label">Название объекта</label>
                        <input type="text" id="id_title" name="title" class="form-control" placeholder="Название объекта" aria-label="Title">
                    </div>
                    <select id="id_type_select" name="type_id" class="form-select" aria-label="Select">
                        <option selected="">Выберите тип объекта</option>
                        <option value="1">Пляжное место</option>
                        <option value="2">Парковка</option>
                        <option value="3">Мероприятие / экскурсия</option>
                        <option value="4">Кафе / ресторан</option>
                        <option value="5">Коворкинг</option>
                        <option value="6">Зона отдыха</option>
                    </select>
                    <select id="id_city_select" name="city_id" class="form-select" aria-label="Select">
                        <option selected="">Выберите город объекта</option>
                        <% for object in cities.iter() { %>
                            <option value="<%= object.id %>"><%= object.name %></option>
                        <% } %>
                    </select>
                    <div class="mb-3">
                        <label class="form-label">Координаты</label>
                        <input type="text" id="id_cord" name="cord" class="form-control" placeholder="Широта и долгота через запятую" aria-label="Сord">
                    </div>
                    <p class="api_response error"></p>
                    <div class="col-md-12">
                        <button type="button" id="create_place" class="btn btn-primary">Создать</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<% include!("../partials/f.stpl"); %>