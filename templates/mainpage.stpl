<% include!("partials/h.stpl"); %>


<div class="main-content app-content">
    <div class="container-fluid">
    <div class="row about-main mb-5 mt-5" style="background-color: rgba(var(--primary-rgb), 0.7);padding: 40px 10px;color: white !important;">
        <div class="col-lg-8 col-md-8 col-sm-12 text-center">
            <div class="mb-3">
                <h5 class="fw-semibold text-fixed-white op-9">Забронируй свое место за 60 секунд</h5>
            </div>
            <h1 class="mb-3 fw-semibold fs-46 text-fixed-white">Добро пожаловать на My Place</h1>
            <p class="leading-normal text-fixed-white fs-16">
                Наши преимущества:<br />
                Универсальность (места, рестораны, парковки)<br />
                Мгновенное бронирование и оплата<br />
                Безопасность
            </p>
            <p class="leading-normal fs-16 btn-list">
                <a href="/about/" class="m-1 btn btn-primary">
                    О нас
                    <i class="fe fe-eye ms-2 align-middle"></i>
                </a>
                <a href="/business/" class="m-1 btn btn-info">
                    Для бизнеса
                    <i class="fe fe-arrow-right ms-2 align-middle"></i>
                </a>
            </p>
        </div>
    </div>

    <div class="row mb-5 rounded-5">
        <p><img src="/assets/images/signup_jpg.jpg" class="rounded-3 w-100" alt="image"></p>
    </div>

    <section class="section section-bg " style="margin-top: 110px;">
                <div class="container text-center position-relative">
                    <p class="fs-12 fw-semibold text-success mb-1">
                        <span class="landing-section-heading">FAQ</span>
                    </p>
                    <div class="landing-title"></div>
                    <h3 class="fw-semibold mb-2">Как это работает</h3>
                    <div class="row justify-content-center">
                        <div class="col-xl-7">
                            <p class="text-muted fs-15 mb-5 fw-normal">
                                Мы используем лучший пользовательский опыт своего дела. Никаких лишних движений, все просто:
                            </p>
                        </div>
                    </div>
                    <div class="row  g-2 justify-content-center">
                        <div class="col-xl-12">
                            <div class="row justify-content-evenly">
                                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 col-12 mb-3">
                                    <div class="card features main-features main-features-4 p-4 active" data-wow-delay="0.1s"> 
                                        <div> 
                                            <h5 class="fw-bold">Создайте аккаунт</h5> 
                                        </div> 
                                    </div>
                                </div>
                                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 col-12 mb-3">
                                    <div class="card features main-features main-features-2 wow p-4"> 
                                        <div> 
                                            <h5 class="fw-bold">Выберите места</h5> 
                                        </div> 
                                    </div> 
                                </div>
                                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 col-12 mb-3">
                                    <div class="card features main-features main-features-3 wow p-4"> 
                                        <div> 
                                            <h5 class="fw-bold">Оплатите стоимость</h5> 
                                        </div> 
                                    </div>
                                </div>
                                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 col-12 mb-3">
                                    <div class="card features main-features main-features-4 wow fadeInUp reveal revealleft p-4 active"> 
                                        <div> 
                                            <h5 class="fw-bold">Получите доступ</h5> 
                                        </div> 
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </section>

            <section class="section " style="margin-top: 110px;"">
                <div class="container text-center">
                    <p class="fs-12 fw-semibold text-success mb-1"><span class="landing-section-heading">Наша миссия</span>
                    </p>
                    <div class="landing-title"></div>
                    <h3 class="fw-semibold mb-2">Мы хотим создать лучший агрегатор заказов мест в Сочи</h3>
                    <div class="row justify-content-center">
                        <div class="col-xl-7">
                            <p class="text-muted fs-15 mb-3 fw-normal">
                                Это будет максимально удобно как желающим приятно провести время в нашем прекрасном городе, 
                                так и для предпринимателей, осуществляющих услуги аренды мест на пляжах, в ресторанах,
                                на парковках, в кинотеатрах, и т.д.
                            </p>
                        </div>
                    </div> 
                    <div class="row justify-content-center align-items-center mx-0">
                        <div class="col-xxl-4 col-xl-5 col-lg-5 text-center text-lg-start">
                            <img src="/assets/images/media/pngs/9.png" alt="" class="img-fluid">
                        </div>
                        <div class="col-xxl-8 col-xl-7 col-lg-7 pt-5 pb-0 px-lg-2 px-5 text-start">
                            <h4 class="text-lg-start fw-medium mb-4">Все культурные и развлекательные места в г. Сочи - на одной платформе!</h4>
                            <div class="row">
                                <div class="col-12 col-md-12">
                                    <div class="d-flex mb-2">
                                        <span>
                                            <i class="bx bxs-badge-check text-primary fs-18"></i>
                                        </span>
                                        <div class="ms-2">
                                            <h6 class="fw-medium mb-0">Надежность и безопасность</h6>
                                            <p class="text-muted mb-3">
                                                Мы выбираем только проверенных поставщиков, лучшие технологии в нашем ПО
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-12">
                                    <div class="d-flex mb-2">
                                        <span>
                                            <i class="bx bxs-badge-check text-primary fs-18"></i>
                                        </span>
                                        <div class="ms-2">
                                            <h6 class="fw-medium mb-0">Клиентоориентированность</h6>
                                            <p class=" text-muted mb-3">
                                                Вы всегда правы. В случае непредвиденной ситуации наша техподдержка и менеджеры в считанные минуты 
                                                придут к вам на помощь.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-md-12">
                                    <div class="d-flex mb-2">
                                        <span>
                                            <i class="bx bxs-badge-check text-primary fs-18"></i>
                                        </span>
                                        <div class="ms-2">
                                            <h6 class="fw-medium mb-0">Гибкие и современные программы лояльности</h6>
                                            <p class=" text-muted">
                                                Приятные скидки самых разных направлений и свойств, система рейтингов мест и пользователей, 
                                                конкурсы и розыгрыши, бонусные программы - все это ждет вас.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div> 
                    </div>
                </div>
            </section>
            <section class="section landing-testimonials section-bg" style="margin-top: 110px;">
