<% include!("../partials/h.stpl"); %>

<div class="main-content app-content">
    <div class="container-fluid">
        <div class="d-md-flex d-block align-items-center justify-content-between my-4 page-header-breadcrumb">
            <div class="my-auto">
                <h5 class="page-title fs-21 mb-1">Партнеры</h5>
                <nav>
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/">Главная</a></li>
                        <li class="breadcrumb-item active">Партнеры</li>
                    </ol>
                </nav>
            </div>
        </div>
        <div class="row row-sm">
            <% for object in list { %>
            <% let user = object.user; %>
			<div class="col-md-6">
                <div class="card custom-card card-bg-light">
                    <div class="card-body">
                        <div class="d-flex align-items-center w-100">
                            <div class="">
                                <div class="fs-15 fw-semibold">
                                    <a href="/place/<%= object.id %>/">
                                        <div class="fs-15 fw-semibold"><%= object.title %></div>
                                    </a>
                                    <p class="mb-0 op-7 fs-12">ИНН: <%= object.inn %></p>
                                    <p class="mb-0 op-7 fs-12">Владелец: <%= user.first_name %> <%= user.last_name %></p>
                                    <hr />
                                    <p class="mb-0 op-7 fs-12">
                                        <span class="remove_partner" style="cursor: pointer">Удалить</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>
    </div>
</div>

<% include!("../partials/f.stpl"); %>